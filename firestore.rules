rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // JUSpa Management System Firestore Rules
    // Allow read/write for all internal spa operational collections
    match /users/{userId} {
      allow read, write: if true;
    }
    match /services/{serviceId} {
      allow read, write: if true;
    }
    match /promotions/{promoId} {
      allow read, write: if true;
    }
    match /inventory/{itemId} {
      allow read, write: if true;
    }
    match /inventory_transactions/{transId} {
      allow read, write: if true;
    }
    match /audit_sessions/{auditId} {
      allow read, write: if true;
    }
    // Test document connection path
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}

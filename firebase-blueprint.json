{
  "entities": {
    "User": {
      "title": "User",
      "description": "Wellness staff and admin accounts with role-based access",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["Doctor", "Management", "Marketing", "Reception", "Accountant", "Product"] },
        "username": { "type": "string" },
        "password": { "type": "string" }
      },
      "required": ["id", "name", "role", "username"]
    },
    "Service": {
      "title": "Service",
      "description": "Spa treatments, massage, facial, laser, and combo packages",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["single", "combo", "spa"] },
        "category": { "type": "string" },
        "priceOriginal": { "type": "number" },
        "pricePromo": { "type": "number" }
      },
      "required": ["id", "name", "priceOriginal"]
    },
    "Promotion": {
      "title": "Promotion",
      "description": "Promotional campaigns and proposals across spa services",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending Design", "Pending Approval", "Approved", "Rejected"] },
        "proposerId": { "type": "string" }
      },
      "required": ["id", "name", "startDate", "endDate", "status", "proposerId"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Stock items, cosmetics, materials, and consumables",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "unit": { "type": "string" },
        "quantity": { "type": "number" },
        "location": { "type": "string" }
      },
      "required": ["id", "name", "unit", "quantity", "location"]
    },
    "InventoryTransaction": {
      "title": "InventoryTransaction",
      "description": "Stock in, stock out, and audit adjustment records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemId": { "type": "string" },
        "itemName": { "type": "string" },
        "type": { "type": "string", "enum": ["in", "out", "audit_adjustment"] },
        "quantity": { "type": "number" },
        "date": { "type": "string" },
        "performedBy": { "type": "string" },
        "performedById": { "type": "string" },
        "remainingStock": { "type": "number" }
      },
      "required": ["itemId", "itemName", "type", "quantity", "date", "performedBy", "remainingStock"]
    },
    "AuditSession": {
      "title": "AuditSession",
      "description": "Monthly stock audit and physical inventory reconciliation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "month": { "type": "number" },
        "year": { "type": "number" },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "createdBy": { "type": "string" },
        "createdDate": { "type": "string" }
      },
      "required": ["id", "name", "month", "year", "status", "createdBy", "createdDate"]
    },
    "MedicalRecord": {
      "title": "MedicalRecord",
      "description": "Clinical patient EMR charts with high-tech laser and device parameters",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerCode": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "skinType": { "type": "string" },
        "diagnosis": { "type": "string" },
        "treatmentPlan": { "type": "string" },
        "totalSessions": { "type": "number" },
        "completedSessions": { "type": "number" }
      },
      "required": ["id", "customerCode", "customerName", "skinType", "diagnosis"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Smart appointment scheduling and clinic room assignments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "serviceName": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "customerName", "serviceName", "date", "time", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Wellness staff user accounts managed by Admin"
    },
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Spa catalog services"
    },
    "/promotions/{promoId}": {
      "schema": "Promotion",
      "description": "Marketing promotions"
    },
    "/inventory/{itemId}": {
      "schema": "InventoryItem",
      "description": "Inventory stock items"
    },
    "/inventory_transactions/{transId}": {
      "schema": "InventoryTransaction",
      "description": "Stock movement logs"
    },
    "/audit_sessions/{auditId}": {
      "schema": "AuditSession",
      "description": "Stock audit sessions"
    },
    "/emr_records/{recordId}": {
      "schema": "MedicalRecord",
      "description": "Electronic medical records"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Clinic appointments and bookings"
    }
  }
}
